APP_NAME=ShopPilot AI API
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:password@host:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY= 

GEMINI_API_KEY=


GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# Phase 6.8: "text" (default) preserves the historical log output;
# "json" renders one JSON object per record with request correlation.
LOG_FORMAT=text

# Phase 6.6: provider call timeouts and the overall RAG request deadline (seconds).
GEMINI_EMBEDDING_TIMEOUT_SECONDS=10
GEMINI_GENERATION_TIMEOUT_SECONDS=30
RAG_REQUEST_DEADLINE_SECONDS=60

# Phase 6.7: per-process provider concurrency, admission waits, and bounded retries.
GEMINI_EMBEDDING_MAX_CONCURRENCY=4
GEMINI_GENERATION_MAX_CONCURRENCY=2
RAG_PROVIDER_CONCURRENCY_WAIT_SECONDS=2
INGESTION_PROVIDER_CONCURRENCY_WAIT_SECONDS=20
GEMINI_RETRY_MAX_ATTEMPTS=2
GEMINI_RETRY_INITIAL_DELAY_SECONDS=0.25
GEMINI_RETRY_WINDOW_SECONDS=3